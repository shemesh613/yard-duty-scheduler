{
  "name": "yard-duty-scheduler",
  "version": "1.0.0",
  "description": "מערכת שיבוץ תורנויות חצר ולוח מגרש מתוך קובץ מערכת שעות",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "engine": "node src/engine/index.js samples/model.sample.json",
    "check": "node tools/check-files.js",
    "check:rules": "node tools/check-rules.js",
    "check:swap": "node tools/check-swap.js",
    "check:edits": "node tools/check-edits.js",
    "check:client": "node tools/check-client.js",
    "state:save": "node tools/state-backup.js save",
    "state:restore": "node tools/state-backup.js restore",
    "state:show": "node tools/state-backup.js show",
    "check:all": "node tools/check-files.js && node tools/check-rules.js && node tools/check-swap.js && node tools/check-edits.js && node tools/check-client.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  }
}
